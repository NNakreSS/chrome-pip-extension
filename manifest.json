{
    "manifest_version": 3,
    "name": "Video Pop-out player",
    "version": "1.0",
    "description": "Videoları ekranın her yerinde uygulamaların üzerinde oynatın.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ],
    "action": {
        "default_title": "Videoyu Pop-out Yap",
        "default_popup": "popup.html"
    }
}